JTRACK_ENV=development
SECRET_KEY=replace-with-a-long-random-value
HOST=127.0.0.1
PORT=5001
FLASK_DEBUG=true

# Local data
ANALYTICS_DATABASE=Backend/dummy_data.db
EXCEL_DATA_PATH=Backend/dummy_data.xlsx
DEFAULT_SQLITE_TABLE=reportdata
API_MAX_PAGE_SIZE=500

# Account enrollment
ALLOW_REGISTRATION=true
ALLOW_ROLE_SELECTION=true
DEFAULT_REGISTRATION_ROLE=Leader

# Optional SharePoint source
USE_SHAREPOINT=false
SP_CLIENT_ID=
SP_CLIENT_SECRET=
SP_SITE_URL=
SP_FILE_PATH=
